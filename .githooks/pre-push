#!/usr/bin/env bash
# shellcheck shell=bash
# pre-push hook v1.17 created 2605 cl-bs updated 2609 cl-bs
#
# universal pre-push guard. three independent checks, all fail closed:
#
# "fail closed" is load-bearing and was not true before v1.4: an errored git
# command and an unresolvable remote URL each used to read as "found
# nothing" and pass the push; both now abort via guard_abort. found by
# review on claude-bocuse#3. an empty ref-update list is different: it has
# nothing to scan (every update was a deletion, or stdin was empty) and
# exits 0, which is correct, not a gap (see the RANGES check below).
#
# one documented exception, so "fail closed" is not read wider than it is:
# MAX_COMMITS caps how many commits per ref are scanned, and beyond it the
# push proceeds with a warning rather than a refusal. see the constant.
#
# v1.7 reconciles two histories that diverged after the same base commit:
# reconcile/ds1-main hardened check 1 and every git call feeding a security
# decision (guard_abort, the redacted credential in the refusal, the
# catalogue path exclusion below); develop independently added the fixture
# marker and the already-published-path distinction. Neither line carried
# the other's feature, so both apply here.
#
# v1.8 closes eight defects a security review found in v1.7: the PII sweep
# echoed a basic-auth password the content scan had already redacted, and
# that same redaction leaked trailing password characters of its own
# (check 2); --no-merges skipped merge commits on both git log walks; the
# new-ref range excluded commits on every remote, not just the one being
# pushed to; the fixture marker exempted any added line that merely started
# with its stripped text, not just an identical one; non-ASCII paths were
# octal-quoted past SECRET_PATH_PATTERN; a **/ glob in SCAN_EXCLUDE_PATHS
# matched a catalogue basename at any depth; the "already published" path
# check compared existence, not content, so a placeholder could be swapped
# for a real secret and only warn; and three low-severity cleanups (see the
# fix sites for detail on each).
#
# v1.9 closes a second review of v1.8: the "already published" content check
# still compared only the TIP blob to the base, so a placeholder swapped for
# a real secret and swapped back in a later commit of the same range
# published the real blob with a warning instead of a block; that same check
# stopped at the FIRST remote base that had the path, so branch sort order
# (not the actual publication history) decided whether a blob counted as
# known; a push target given as a bare URL (`git push URL ref`, $1 has no
# configured remote) was printed verbatim wherever the remote name normally
# goes, including the "remote:" line inside a check-1 refusal, which is the
# one place a URL is most likely to carry the credential that triggered it;
# the PII sweep masked only URL userinfo, so a blocked token immediately
# followed by "@domain.tld" in the source line still printed the token in
# full under an advisory heading; the check-1 and PII redactions stopped at
# the FIRST "@" in a userinfo, leaking everything after a second one; the
# generic basic-auth URL pattern required a non-empty password, so
# "user:@host" (empty password) was not recognised as basic-auth shaped; a
# fixture-marked line with trailing whitespace before its marker could not
# be exempted, because the marker-strip trimmed the TIP copy but the
# diff-added unmarked copy kept its trailing spaces and the whole-line
# compare never matched; and a remote name containing `*`, `?`, `[` or `|`
# (reachable via `git config remote.<name>.url` naming an odd remote, or
# `git push '*' ref`) either widened the `--glob=refs/remotes/NAME/*`
# exclusion past that one remote or broke the `|`-packed range split.
#
# v1.17 (2026-09-30) lets the literal companion marker ", secret-scan:allow"
# follow the fixture marker; any other text after it still blocks.
#
# v1.15 (2026-09-29) drops the exclusion for claude/plugins/bjoern-core,
# which config 136a383 deleted; the pathspec matched nothing.
#
# v1.14 (2026-09-28) takes the one fix the parallel v2.0 line had and this
# one lacked: the fixture marker must end the line, so a live token after a
# mid-line marker stays in the blocking scan.
#
# v1.12 (2026-09-28) merges the main line (v1.6 to v1.11), which grew beside
# this one on another host: check 3, the direct-push guard for a PR forge,
# with the host parsed and case-folded and every trailing root dot dropped;
# a rename or copy of a secret-shaped path counts under BOTH names, so `git
# mv id_rsa backup.txt` is refused where the blob walk alone read the source
# as deleted; the URL check reads a here-string, which has no writer for
# grep -q to kill; and four more catalogue files join the exact-path content
# exclusion.
#
#   1. remote URL: reject a push to a remote whose URL embeds a credential
#      or token shape. catches a URL added to .git/config in a prior
#      session or by another tool. canonical patterns mirror
#      ~/.claude/hooks/block-dangerous-commands.sh.
#   2. payload: reject a push whose commits ADD secret-shaped content or a
#      secret-shaped filename. a filename the remote already carries is
#      reported, not blocked: the push cannot un-publish it. personal
#      identifiers (email, phone, private address, rfc1918 host) are
#      reported as a warning, not a block: a personal dotfiles repo
#      legitimately carries the owner's name and home paths, so blocking
#      on those would make the hook unusable.
#   3. default branch: refuse a direct push to main, master or the remote's
#      recorded default branch when the remote is a PR forge (github.com).
#      ALLOW_PUSH_TO_MAIN=1 overrides once, deliberately.
#
# the master of this file is ~/config/.githooks/pre-push, and every other
# copy is a mirror: `dotfiles.sh git-hooks --apply` copies the master into
# every discovered repo's .githooks/ and sets core.hooksPath, so a change
# belongs in the master, extends the catalogue everywhere, and an edit to a
# mirror is overwritten on the next apply. the sentence used to read "this
# file is the MASTER", which was false in every mirror it was copied into
# (copilot review of research-general#141, 2026-09-29). keep it
# self-contained: it runs inside repos that cannot see ~/bin.
#
# install: git config core.hooksPath .githooks   (per clone; dotfiles.sh does it)
# bypass:  git push --no-verify   (git itself; nothing here can prevent that)
# refresh: git fetch --prune   (run this periodically; the new-ref check below
#          trusts local refs/remotes/<name>/* tracking refs as "the remote
#          already has this", and a stale one (a branch deleted on the
#          remote after your last fetch) is trusted anyway. --prune keeps
#          that trust honest; this hook cannot detect staleness on its own.)
set -o errexit -o nounset -o pipefail -o errtrace
IFS=$'\n\t'

# newest commits scanned per ref update. a first push to an empty remote
# would otherwise walk the entire history.
#
# this is the ONE place the guard is not fail-closed, so it is stated rather
# than buried: beyond this many commits per ref the older ones are NOT
# scanned, and the push proceeds with a warning naming how many were skipped.
# blocking instead would stop every legitimate first push of a large repo.
# (copilot review, claude-bocuse#4, which correctly called the header
# inconsistent with this behaviour.)
readonly MAX_COMMITS=1000

# fail closed. every git invocation below feeds a security decision, so a
# command that ERRORS must not be read as "found nothing": that inverts the
# guard into a pass. `2>/dev/null || true` on a scan is the same defect as an
# empty match set. called with a reason; never returns.
guard_abort() {
    printf '[error] pre-push: cannot verify this push, refusing it\n' >&2
    printf '[error]   reason: %s\n' "${1}" >&2
    printf '[info]  this is fail-closed by design. re-run once the repository\n' >&2
    printf '[info]  state is readable, or bypass deliberately with --no-verify.\n' >&2
    exit 1
}

# redact a credential-bearing URL's userinfo and query string before it is
# ever echoed. greedy to the LAST "@" before the next "/" or whitespace: a
# character class that excludes "@" (the v1.8 spelling) stops at the FIRST
# "@", so a userinfo with a second "@" in it (a password containing one, or
# `user:@x@host` layered past the first delimiter) left everything after
# that first "@", including the rest of the credential, printed in full.
redact_url() {
    # excludes only whitespace, not "/": a v1.8 fix deliberately allows a
    # literal "/" inside the matched span, because a userinfo carrying one
    # (percent-encoded content, or malformed input) must still redact in
    # full; excluding "/" here reopened that defect (a slash anywhere
    # before the last "@" stopped the match short and left everything from
    # the slash onward, credential included, unredacted). the safe
    # direction to err is over-redaction (swallowing host/path text into
    # [REDACTED]) never under-redaction (leaking a credential character),
    # so greedy-to-the-last-"@" is left unbounded by "/" on purpose.
    printf '%s' "${1}" | sed -E -e 's|://[^[:space:]]*@|://[REDACTED]@|' -e 's|\?.*$|?[REDACTED]|'
}

# git always passes both args during a real push: $1 = remote name, $2 = remote
# URL. when invoked manually with no args (e.g. `bash .githooks/pre-push`),
# print a brief usage and exit 0; a clean no-op rather than a silent
# fallback that would check `origin` and mask which remote was intended.
if [[ "$#" -eq 0 ]]; then
    printf '[info] pre-push: usage: %s <remote-name> <remote-url>\n' "$(basename "$0")" >&2
    printf '[info] invoked manually with no args; nothing to check.\n' >&2
    exit 0
fi

REMOTE_NAME="${1}"
REMOTE_URL_ARG="${2:-}"

# one display name for the remote, computed once and used everywhere
# $1/REMOTE_NAME reaches output, INCLUDING the guard_abort call directly
# below: git passes a bare URL as $1 when the push target has no configured
# remote name (`git push URL ref`), and every call site that printed
# REMOTE_NAME verbatim copied that URL, credential and all, into stderr.
# the "remote:" line inside a check-1 refusal is the one place this is most
# damaging, since a URL reaching that line already matched a credential
# pattern by construction.
REMOTE_DISPLAY="${REMOTE_NAME}"
if [[ "${REMOTE_NAME}" == *"://"* ]]; then
    REMOTE_DISPLAY="$(redact_url "${REMOTE_NAME}")"
fi
readonly REMOTE_DISPLAY

# a remote name carrying a glob metacharacter or the range-args separator
# changes how this hook scopes its OWN scan, not just how it looks: `*`, `?`
# or `[` inside `--glob=refs/remotes/${REMOTE_NAME}/*` (the new-ref exclusion
# below) is interpreted by git as a glob, so REMOTE_NAME="*" widens "this
# remote already has it" to "ANY configured remote already has it", exactly
# the per-remote scoping fix below this comment exists to prevent, undone by
# one character. `|` breaks the "revs|extra-args" packed string that gets
# split on `|` further down. reachable without touching argv: `git config
# 'remote.*.url' URL` then `git push '*' ref`. refuse before either
# mechanism runs.
if [[ "${REMOTE_NAME}" == *[*?[\|]* ]]; then
    guard_abort "remote name '${REMOTE_DISPLAY}' contains a character (one of * ? [ |) that changes how this hook scopes its scan"
fi

# buffer the ref updates before anything else. git feeds them on stdin as
# `<local-ref> <local-sha> <remote-ref> <remote-sha>` and they can only be
# read once; the payload scan needs them, and git-lfs needs them replayed
# verbatim if we chain to it at the end.
REF_UPDATES=""
if [[ ! -t 0 ]]; then
    REF_UPDATES="$(cat || true)"
fi

# fall back to `git remote get-url` when $2 is empty (rare, but handles
# tools that pass only the remote name).
REMOTE_URL="${REMOTE_URL_ARG}"
if [[ -z "${REMOTE_URL}" ]]; then
    REMOTE_URL="$(git remote get-url "${REMOTE_NAME}" 2>/dev/null || true)"
fi

# check 1: remote URL

DANGEROUS_URL_PATTERNS=(
  # known token formats inside an https URL userinfo segment
  'https?://[^[:space:]/@]*(gho_|ghp_|github_pat_|glpat-)[A-Za-z0-9_-]+@'

  # generic https basic-auth (user:password@); legitimate auth in 2026
  # uses credential helpers (libsecret) or ssh, never inline.
  #
  # the password segment is `*` (zero or more), not `+`: an empty password
  # (`user:@host`) is still basic-auth shaped and was missed when the
  # segment required at least one character, which also meant a second,
  # unescaped userinfo delimiter placed right after the colon
  # (`ghp_TOKEN:@x@host`) matched neither this pattern (empty password) nor
  # the known-token-prefix pattern above (which requires the token run to
  # be followed immediately by "@", not ":"). neither segment excludes "@"
  # any more either, so the match is greedy to the LAST colon/"@" pair
  # rather than stopping at the first, the same reasoning as redact_url().
  'https?://[^[:space:]/]+:[^[:space:]/]*@'

  # percent-encoded character anywhere in the userinfo segment.
  # legitimate userinfos rarely percent-encode; abuse pattern is to encode
  # the first byte of a token prefix (`%67ho_xxx` for `gho_xxx`) to evade
  # literal-prefix matchers. block conservatively.
  #
  # the [/][/] spelling is deliberate: this line is the one URL pattern the
  # basic-auth CONTENT pattern above would otherwise match, which blocked
  # the push that adds this hook. inert in the regex, breaks the self-match.
  'https?:[/][/][^[:space:]@]*%[a-fA-F0-9]{2}[^[:space:]@]*@'

  # env-var indirection in userinfo (`https://${TOKEN}@host`,
  # `https://$TOKEN@host`). either the var resolves to a token at push
  # time (leak vehicle) or the URL is malformed; both cases warrant
  # blocking.
  'https?://[^[:space:]/@]*\$\{?[A-Za-z_][^[:space:]/@]*@'
)

# an unresolvable remote URL is not a pass: check 1 cannot run, and the whole
# point of it is that the URL may be the leak. refuse rather than skip.
if [[ -z "${REMOTE_URL}" ]]; then
    guard_abort "remote '${REMOTE_DISPLAY}' has no resolvable URL, so the URL check cannot run"
fi

if [[ -n "${REMOTE_URL}" ]]; then
    for PATTERN in "${DANGEROUS_URL_PATTERNS[@]}"; do
        # a here-string, not `printf | grep -q`: grep -q may exit on the first
        # match while printf still writes, and under pipefail the SIGPIPE would
        # read as "no match". (copilot review, languages#2.) not reproduced on
        # fry1 at 100 KB; kept because a here-string has no writer to kill.
        if grep -qE -- "${PATTERN}" <<< "${REMOTE_URL}"; then
            # redact the userinfo before printing. this URL matched a
            # credential pattern, so by construction it CONTAINS the secret;
            # echoing it verbatim would copy the leak into the terminal
            # scrollback, the CI log and any screen recording. host and path
            # stay, which is all that is needed to identify the remote.
            # (copilot review, claude-bocuse#4)
            # the query string is masked too: a token can ride in
            # ?access_token= as well as in the userinfo. redact_url() is
            # greedy to the LAST "@", not the first: see its definition.
            REDACTED_URL="$(redact_url "${REMOTE_URL}")"
            printf '[error] pre-push: remote URL embeds a credential or token shape\n' >&2
            printf '[error]   remote:  %s\n' "${REMOTE_DISPLAY}" >&2
            printf '[error]   url:     %s\n' "${REDACTED_URL}" >&2
            printf '[error]   pattern: %s\n' "${PATTERN}" >&2
            printf '[error] use credential.helper (libsecret) or ssh; rotate any leaked\n' >&2
            printf '[error] token at the issuer immediately if it has been pushed.\n' >&2
            exit 1
        fi
    done
fi

# check 2: payload

# secret-shaped CONTENT. specific by design: a false positive blocks a
# push, so breadth belongs in the advisory list, not here.
#
# every pattern must be written so it does not match its own source line:
# this file is itself pushed through the hook, and a pattern that matches
# the catalogue that defines it blocks the commit that adds the hook. two
# did. a bracket around one literal character ([-] for -, [/] for /) is
# inert in the regex and breaks the self-match.
#
# named separately, not inlined in the array below: the redaction loop has
# to recognise this one pattern by identity, because a partial 4+4 slice of
# a basic-auth MATCH ("://user:pw@") leaks trailing password characters,
# up to the whole password when it is short, where every other pattern's
# match is the secret itself and a slice of it is merely less of the same
# secret, not a decodable fragment of a DIFFERENT one.
readonly BASIC_AUTH_CONTENT_PATTERN=':[/][/][^[:space:]/@]+:[^[:space:]/@]+@'

SECRET_CONTENT_PATTERNS=(
    'gh[pousr]_[A-Za-z0-9]{36,}'
    'github_pat_[A-Za-z0-9_]{82,}'
    'glpat-[A-Za-z0-9_-]{20,}'
    'AKIA[0-9A-Z]{16}'
    'AIza[0-9A-Za-z_-]{35}'
    'sk-ant-[A-Za-z0-9_-]{20,}'
    'sk-[A-Za-z0-9]{32,}'
    'xox[baprs]-[A-Za-z0-9-]{10,}'
    '-----BEGIN ([A-Z]+ )?PRIVATE KEY-----'
    'PuTTY-User-Key-File[-]'
    # jwt: three base64url segments
    'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
    # basic-auth credentials inside any URL
    "${BASIC_AUTH_CONTENT_PATTERN}"
)

# files that DEFINE or TEST the catalogue above, excluded from the CONTENT
# scan only.
#
# the bracket evasion protects the CURRENT text of this file, but the scan
# walks `git log -p` over the whole push range, and every earlier revision in
# that range still carries the pre-evasion spelling. so the hook blocks its
# own history permanently: v1.2 ("stop the hook blocking its own adoption")
# fixed the tip and the push stayed blocked, which is how ~/config reached 85
# unpushed commits and ~/bin 80.
#
# the exclusion is narrow by design. it drops content matching for the
# known catalogue and fixture paths below; the FILENAME scan still covers
# them, and every other path in the repo is scanned exactly as before. a real
# credential pasted into one of these files would be missed, which is the
# accepted cost of a catalogue that can describe itself.
#
# check-hook-guards.sh joined the list on 2026-09-06. it probes each guard
# with a sample that must match, so it necessarily carries credential-shaped
# fixtures (ghp_AAAA..., secret@github.com). without the entry it could never
# be pushed, and a guard whose own test suite is unpushable gets deleted
# rather than fixed.
#
# exact repo-relative paths, not `**/<basename>` globs: a leading `**/` with
# no directory component before the filename matches that basename at ANY
# depth, so `**/check-hook-guards.sh` also excluded an attacker-planted
# `anywhere/check-hook-guards.sh` from the content scan. every path below is
# a real file confirmed via `git ls-files` in this repo, or (this hook is the
# MASTER mirrored into every repo's .githooks/, per the file header) in
# `~/bin`, the other repo that carries the same catalogue at different paths.
#
# secret-content-patterns.txt is the pattern catalogue itself: it documents the
# credential shapes it matches, so it matches itself. on 2026-09-07 its own
# comment "(scheme://user:pass@host)" blocked every push carrying the file, the
# guard's first day in service. test-secret-scan.sh is its fixture file and is
# required by design to carry a sample per pattern, the same reason
# test-pre-push.sh is listed. lib-redact.sh is the redaction pattern catalogue
# and carries one fixture per pattern; feedback_token_url_guard.md documents
# the token-URL guard's own regexes, so it matches itself (both 2026-09-24).
# the repo skeletons under agents/policy/templates/ carry byte copies of this
# hook and its suite so a new repo starts guarded; the exact paths of those
# copies are listed for the same reason as the masters (2026-09-28).
SCAN_EXCLUDE_PATHS=(
  ':(exclude).githooks/pre-push'
  ':(exclude).githooks/test-pre-push.sh'
  ':(exclude)agents/policy/templates/repo-skeleton/content/.githooks/pre-push'
  ':(exclude)agents/policy/templates/repo-skeleton/content/.githooks/test-pre-push.sh'
  ':(exclude)agents/policy/templates/repo-skeleton/product/.githooks/pre-push'
  ':(exclude)agents/policy/templates/repo-skeleton/product/.githooks/test-pre-push.sh'
  ':(exclude).githooks/secret-content-patterns.txt'
  ':(exclude).githooks/test-secret-scan.sh'
  ':(exclude)claude/hooks/block-dangerous-commands.sh'
  ':(exclude)claude/hooks/test-block-dangerous-commands.sh'
  ':(exclude).claude/hooks/block-dangerous-commands.sh'
  ':(exclude).claude/hooks/test-block-dangerous-commands.sh'
  ':(exclude)agents/pack-harness.sh'
  ':(exclude)pack-harness.sh'
  ':(exclude)check-hook-guards.sh'
  ':(exclude)claude/hooks/lib-redact.sh'
  ':(exclude)claude/memory/feedback_token_url_guard.md'
)

# plain repo-relative paths, one home for the list: the SKIPPED_CONTENT
# report below used to carry its own hand-copied regex of the same paths,
# and the two drifted (a path added to one was not added to the other) with
# nothing to catch it.
SCAN_EXCLUDE_PATHS_PLAIN="$(printf '%s\n' "${SCAN_EXCLUDE_PATHS[@]}" | sed 's/^:(exclude)//')"
readonly SCAN_EXCLUDE_PATHS_PLAIN

# per-line opt-out for deliberate test fixtures, for a file the path
# exclusion above does not cover.
#
# claude/hooks/test-block-dangerous-commands.sh has to carry secret-shaped
# samples: its whole job is proving the deny-pattern guards can fire, and a
# sample that does not look like a credential proves nothing. Files that
# DEFINE or TEST this catalogue wholesale are excluded by path above; this
# marker is for a single planted line inside a file that is otherwise
# scanned in full. Until 2026-09-06 the refusal advised "for fixtures,
# replace the value with an obvious placeholder", which cannot be done
# (':[/][/]x:y@' matches however obviously fake x and y are), so the advice
# sent you round a loop that never terminates.
#
# the marker is a claim by whoever wrote the line, not a proof, and it is
# plainly visible in the diff under review. It exempts THAT line only, and
# only from the blocking content scan: filenames, restricted stores and the
# advisory PII sweep are unaffected, so a marked line still cannot smuggle
# past id_rsa or a .pem path. Deliberately not a path or file allowlist: a
# whole exempt file would stop being scanned the day it grows a real secret.
readonly FIXTURE_MARKER='pre-push: fixture'

# secret-shaped FILENAMES and restricted stores. a file whose name says
# "private key" is a leak regardless of what the content scan makes of it.
readonly SECRET_PATH_PATTERN='(^|/)(id_rsa|id_ed25519|id_ecdsa|\.netrc|credentials\.json)$|\.(pem|key|p12|pfx|jks|keystore|kdbx|ovpn|token)$|(^|/)\.(env|secret)$|\.secret$|(^|/)(ssh|\.ssh|\.password-store|\.gnupg|\.gpg|\.cert|\.pki|\.dat)/|(ssh|gpg|git)\.zip$'

# personal identifiers. ADVISORY: reported, never blocking.
PII_PATTERNS=(
    '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
    '\+49[0-9 /-]{8,}'
    '\b(10|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}\b'
)

# check 3: refuse a direct push to the default branch.
#
# The repo conventions say updates land via PR and that "direct push is
# blocked at GitHub level". That was not true: branch protection on both
# ybiyrit/research-academic and ybiyrit/design-system carries
# enforce_admins=false, so the owner pushing to main is waved through and
# the API still answers "protected: true". A protection that exempts the
# only person who uses the repo is decorative, and on 2026-09-08 a commit
# reached design-system main that way without review.
#
# This is the local half of the fix, and it fires before the network round
# trip. The server half is `enforce_admins`, which has to be set per repo.
#
# Override for the case the convention already allows, a first push to an
# empty remote, or an emergency the operator has decided on:
#   ALLOW_PUSH_TO_MAIN=1 git push ...
DEFAULT_BRANCH_RE='^refs/heads/(main|master)$'
# the remote's own default counts too, where the clone knows it: a repo on
# trunk or develop was not protected by the fixed pair. (copilot review,
# claude-bocuse#5.) known limit: this reads the cached refs/remotes/<r>/HEAD;
# a clone that never recorded it (git remote add without fetch) gets an
# empty value, and the main/master pair still applies. querying the remote
# here would add a network round trip to every push.
REMOTE_DEFAULT="$(git symbolic-ref -q --short "refs/remotes/${REMOTE_NAME}/HEAD" 2>/dev/null || true)"
REMOTE_DEFAULT="${REMOTE_DEFAULT#"${REMOTE_NAME}"/}"
# only on a forge that has pull requests. ~/config, ~/bin and the other
# dotfiles repos push main straight to a private git remote on the NAS,
# where there is no PR to land through; refusing there would break the
# ordinary workflow of 30-odd repos to enforce a rule that does not apply
# to them.
# the host, parsed and case-folded. the old `*github.com*` substring let
# git@GITHUB.COM:o/r through (claude#3); v1.7's boundary regex still matched
# github.com as a PATH segment, https://git.example/github.com/r (fleet
# review of v1.7). so read the authority: scheme://[user@]host[:port]/...
# or the scp form [user@]host:path. ssh.github.com is GitHub's ssh-over-443.
REMOTE_URL_LC="${REMOTE_URL,,}"
REMOTE_HOST=""
if [[ "${REMOTE_URL_LC}" =~ ^[a-z][a-z0-9+.-]*://([^/@]*@)?([^/:]+) ]]; then
    REMOTE_HOST="${BASH_REMATCH[2]}"
elif [[ "${REMOTE_URL_LC}" =~ ^([^@/:]+@)?([^/:]+): ]]; then
    REMOTE_HOST="${BASH_REMATCH[2]}"
fi
# a fully qualified name with the root dot, github.com., resolves to the same
# host and passed the comparison in v1.9 (design-system#90 review). known
# limit: an ssh alias (git@gh:o/r with HostName github.com in ssh config)
# names no host here; url.insteadOf and pushurl are resolved before the hook.
while [[ "${REMOTE_HOST}" == *. ]]; do REMOTE_HOST="${REMOTE_HOST%.}"; done
if [[ "${ALLOW_PUSH_TO_MAIN:-0}" != "1" && ( "${REMOTE_HOST}" == "github.com" || "${REMOTE_HOST}" == "ssh.github.com" ) ]]; then
    while IFS=' ' read -r _L_REF L_SHA R_REF _R_SHA; do
        [[ -z "${L_SHA}" ]] && continue
        # a deletion is refused by branch protection anyway, and is not a
        # publish of new commits; leave it to the server.
        [[ "${L_SHA}" =~ ^0+$ ]] && continue
        if [[ "${R_REF}" =~ ${DEFAULT_BRANCH_RE} || ( -n "${REMOTE_DEFAULT}" && "${R_REF}" == "refs/heads/${REMOTE_DEFAULT}" ) ]]; then
            printf '[fail] pre-push: refusing a direct push to %s\n' "${R_REF}" >&2
            printf '[info] this repo lands changes through a pull request:\n' >&2
            printf '[info]   git switch -c <branch> && git push -u %s <branch>\n' "${REMOTE_DISPLAY}" >&2
            printf '[info]   gh pr create --base %s\n' "${R_REF#refs/heads/}" >&2
            printf '[info] override once, deliberately: ALLOW_PUSH_TO_MAIN=1 git push ...\n' >&2
            exit 1
        fi
    done <<< "${REF_UPDATES}"
fi

# collect the rev ranges this push would publish.
RANGES=()
# the remote-side sha per range, or "" for a ref the remote does not have
# yet. the path scan needs it to tell a newly published secret-shaped path
# from one the remote already carries.
RANGE_BASES=()
TIP_SHAS=()
SKIPPED_NOTE=""
# IFS must be a space for this read: git separates the four fields with
# spaces, and the strict-mode IFS=$'\n\t' above would put the whole line
# into the first variable and leave every sha empty (a silently empty
# range that scans nothing and passes everything).
while IFS=' ' read -r _LOCAL_REF LOCAL_SHA _REMOTE_REF REMOTE_SHA; do
    # a here-string of the empty string still yields ONE iteration, so an empty
    # REF_UPDATES would otherwise fabricate a range of "..", which rev-list
    # rejects and which used to be swallowed as "nothing to scan".
    [[ -z "${LOCAL_SHA}" ]] && continue
    # deletion: the local side is all zeros, nothing is published.
    [[ "${LOCAL_SHA}" =~ ^0+$ ]] && continue
    if [[ "${REMOTE_SHA}" =~ ^0+$ ]]; then
        # new ref: everything reachable from it that THIS remote does not
        # already have. on a first push to an empty remote that is the whole
        # history, hence the cap below.
        #
        # `--not --remotes` used to exclude commits on ANY configured
        # remote's tracking refs, not just this one: a token already on
        # origin/main scanned as "covered" when pushing the same commit as a
        # new ref to a second remote, which had never seen it. scope the
        # exclusion to this remote's own tracking refs, matching the
        # for-each-ref base used for the already-published check below.
        #
        # this trusts refs/remotes/${REMOTE_NAME}/* as-is, staleness and
        # all: a branch git deleted on the remote after your last fetch still
        # has a local tracking ref until you prune it, and this exclusion
        # reads that stale ref as "the remote already has this" even though
        # it currently does not. run `git fetch --prune` on a schedule (see
        # the file header) rather than treating a fetch as a one-time setup
        # step; this hook has no way to tell a stale ref from a live one.
        RANGES+=("${LOCAL_SHA}|--not|--glob=refs/remotes/${REMOTE_NAME}/*")
        RANGE_BASES+=("")
    else
        RANGES+=("${REMOTE_SHA}..${LOCAL_SHA}|")
        RANGE_BASES+=("${REMOTE_SHA}")
    fi
    TIP_SHAS+=("${LOCAL_SHA}")
done <<< "${REF_UPDATES}"

# fixture-marked lines as they stand at the TIP of each ref being pushed,
# with the marker stripped off.
#
# Without this, the marker cannot exempt a line older than itself. The range
# walk reads every added line across the range, so a fixture added unmarked
# in one commit and marked in a later one is still scanned in its unmarked
# form, and blocks the push forever after: check-hook-guards.sh:170 was
# added by 5272cdd and marked afterwards, which blocked every push of that
# range with no way out (the hook has no override switch). Measured
# 2026-09-08.
#
# The claim this honours is the same one the inline marker already makes,
# read at the tip instead of at the commit that happened to introduce the
# line. It does widen the marker: a real credential added in one commit and
# marked in a later one is exempted, where before only same-commit marking
# worked. That is the cost of a marker that survives a rebase or a
# follow-up fix, and it stays a visible claim in the tip tree either way.
#
# The match is a whole-line, fixed-string comparison against "+<text>"
# (grep -vxF), not a substring test: a marked line only exempts an earlier
# revision of ITSELF, where the diff-added line is byte-identical to the
# tip's stripped text. A substring test used to exempt any added line that
# merely CONTAINED the stripped fixture text, so a short marked placeholder
# whose stripped text happened to be a PREFIX of an unrelated real secret
# line waved that real secret through too: `export TOKEN=ghp_ <!-- ... -->`
# exempted every line starting with `export TOKEN=ghp_`, marked or not.
# Rewrapping a comment as you mark it still breaks the exemption (the line
# no longer matches verbatim) and the push stays blocked with no hint why.
# Append the marker, do not reflow the line.
#
# Only whitespace, a comment introducer or an HTML comment closer may follow
# the marker, because the strip has to reproduce the original line exactly.
# `<!-- pre-push: fixture -->` is the markdown form: the memory corpus
# tabulates these patterns in prose, where a bare `#` is not a comment.
TIP_FIXTURES=""
for SHA in "${TIP_SHAS[@]}"; do
    TIP_FIXTURES="${TIP_FIXTURES}$(git grep -h -F -- "${FIXTURE_MARKER}" "${SHA}" 2>/dev/null || true)"$'\n'
done
# strip the marker and any comment introducer left dangling before it, trim,
# drop anything too short to identify a line on its own (a 3-character
# pattern would exempt half the diff), then re-prefix with "+" so each
# pattern reads as a whole ADDED diff line, not a bare fragment of one.
#
# the explicit trailing-whitespace trim is not redundant with the comment
# strip above it: that strip only removes a trailing run of `#`/`;` and the
# whitespace immediately touching it, so a marker preceded DIRECTLY by
# whitespace with no comment character (`value   # pre-push: fixture` where
# the code itself, not just the comment, carries trailing spaces before the
# `#`) leaves the comment-strip's own leading `[[:space:]]*` to consume them
# (which it does here), but a line whose marker sits right after
# meaningful trailing whitespace with NO `#`/`;` at all would not be
# touched by that pattern. trim unconditionally rather than rely on the
# comment-strip's incidental coverage.
TIP_FIXTURES="$(printf '%s\n' "${TIP_FIXTURES}" \
    | sed "s/${FIXTURE_MARKER}.*$//" \
    | sed -E 's/[[:space:]]*<!--[[:space:]]*$//' \
    | sed 's/[[:space:]]*[#;]*[[:space:]]*$//' \
    | sed -E 's/[[:space:]]+$//' \
    | awk 'length($0) >= 12' \
    | sed 's/^/+/' \
    | sort -u || true)"

if [[ "${#RANGES[@]}" -eq 0 ]]; then
    exit 0
fi

printf '[info] pre-push: scanning %d ref update(s) to %s\n' "${#RANGES[@]}" "${REMOTE_DISPLAY}" >&2

FOUND=0
PII_REPORT=""
for (( RANGE_INDEX = 0; RANGE_INDEX < ${#RANGES[@]}; RANGE_INDEX++ )); do
    RANGE="${RANGES[RANGE_INDEX]}"
    RANGE_BASE="${RANGE_BASES[RANGE_INDEX]}"
    # split the packed "revs|extra-args" entry back into git arguments
    IFS='|' read -r -a REV_ARGS <<< "${RANGE}"
    ARGS=()
    for A in "${REV_ARGS[@]}"; do
        [[ -n "${A}" ]] && ARGS+=("${A}")
    done
    [[ "${#ARGS[@]}" -eq 0 ]] && continue

    # a failed rev-list must not read as "0 commits, nothing to scan": that is
    # the difference between an empty range and an unreadable one. the
    # common cause is a --force push whose pre-push-reported remote sha was
    # never fetched into this clone, so rev-list cannot resolve the base end
    # of the range; the hint names that before the user goes looking for a
    # git bug.
    if ! COUNT="$(git rev-list --count "${ARGS[@]}" 2>/dev/null)"; then
        guard_abort "git rev-list failed for range '${ARGS[0]}'; fetch the remote first (git fetch) if this range's base sha is not yet in this clone's object database, e.g. after a --force push"
    fi
    [[ "${COUNT}" =~ ^[0-9]+$ ]] || guard_abort "git rev-list returned a non-numeric count for '${ARGS[0]}'"
    [[ "${COUNT}" -eq 0 ]] && continue
    LIMIT=()
    if [[ "${COUNT}" -gt "${MAX_COMMITS}" ]]; then
        LIMIT=(--max-count="${MAX_COMMITS}")
        SKIPPED_NOTE="${SKIPPED_NOTE}${SKIPPED_NOTE:+; }$(( COUNT - MAX_COMMITS )) older commit(s) in ${ARGS[0]} not scanned"
    fi

    # one walk per range. -p over the range (rather than a squashed diff)
    # still catches a secret added in one commit and removed in a later
    # one: both remain in the published history.
    # capture the walk on its own before filtering: piping straight into grep
    # would hand the pipeline grep's status and hide a git failure, which then
    # reads as an empty diff and passes the push.
    #
    # --diff-merges=first-parent, not --no-merges: --no-merges drops merge
    # commits from the walk entirely, so content added only as part of the
    # merge itself (a conflict resolution, or `merge --no-commit --no-ff`
    # then `git add`) was never diffed and never scanned. first-parent still
    # shows exactly what the merge changed relative to the branch it landed
    # on, which is what "published" means here. verified on git 2.43.
    if ! DIFF_RAW="$(git log -p --no-color --diff-merges=first-parent --unified=0 "${LIMIT[@]}" "${ARGS[@]}" \
        -- . "${SCAN_EXCLUDE_PATHS[@]}" 2>/dev/null)"; then
        guard_abort "git log -p failed for range '${ARGS[0]}'; the content scan did not run"
    fi
    ADDED="$(printf '%s\n' "${DIFF_RAW}" | grep -E '^\+' | grep -vE '^\+\+\+' || true)"

    # drop fixture-marked lines before the blocking scan only. PII below still
    # reads ADDED, so an exempted line is reported there if it carries an
    # identifier: advisory, never blocking, which is the right noise level
    # for a line someone has already declared fake.
    # the marker must END the line. A plain substring test exempted any added
    # line that merely CONTAINED the text, so `token=ghp_... pre-push: fixture
    # and then more content` dropped out of the blocking scan while the
    # smuggled value sat in the part after it.
    #
    # A review asked for a comment introducer (#, ; or <!--) as well. Not
    # adopted: the strip logic above documents a marker preceded by bare
    # whitespace with no comment character as valid, and a real line in the
    # corpus uses that form. Requiring an introducer would stop exempting
    # lines this hook has always exempted. Suffix position is the part that
    # carries the risk.
    #
    # The one exception is the literal companion marker of secret-scan.sh,
    # ", secret-scan:allow": a fixed string cannot carry a token, and
    # ~/bin's lib-redact.sh put it after this marker in 5b8abab, so the
    # end-of-line rule refused every push of that published commit.
    SCANNED="$(printf '%s\n' "${ADDED}" \
        | grep -vE -- "${FIXTURE_MARKER}(,?[[:space:]]*secret-scan:allow)?[[:space:]]*(-->)?[[:space:]]*\$" || true)"
    # and the same line in its pre-marker form, per TIP_FIXTURES above. the
    # emptiness guard is load-bearing: an empty pattern list would feed grep a
    # blank line, which matches everything and would exempt the whole diff.
    if [[ -n "${TIP_FIXTURES}" ]]; then
        # -x: whole-line match. TIP_FIXTURES patterns carry the "+" prefix
        # added above, so this drops an ADDED line only when it is
        # byte-identical to a fixture-marked line at the tip, never merely
        # prefixed by one. see the TIP_FIXTURES comment above.
        #
        # trim trailing whitespace on THIS side too, matching the trim
        # TIP_FIXTURES already carries: an unmarked commit's diff-added line
        # keeps whatever trailing whitespace the file actually had (git does
        # not trim it), while the marker-strip above trims the marked TIP
        # copy of that same line. without a matching trim here the two
        # copies of one line compare unequal on trailing whitespace alone,
        # and a fixture marked after the fact (v1.3's whole-line case, see
        # above) never matches its own earlier, unmarked, whitespace-padded
        # revision: the marker cannot exempt the very line it describes.
        SCANNED="$(printf '%s\n' "${SCANNED}" \
            | sed -E 's/[[:space:]]+$//' \
            | grep -vxFf <(printf '%s\n' "${TIP_FIXTURES}") || true)"
    fi

    if [[ -n "${ADDED}" ]]; then
        for PATTERN in "${SECRET_CONTENT_PATTERNS[@]}"; do
            HITS="$(printf '%s\n' "${SCANNED}" | grep -oE -- "${PATTERN}" | sort -u || true)"
            [[ -z "${HITS}" ]] && continue
            printf '[error] pre-push: secret-shaped content added, pattern: %s\n' "${PATTERN}" >&2
            while IFS= read -r HIT; do
                # redact: enough to identify the hit, not enough to reuse it.
                # a basic-auth match ("://user:pass@") is redacted WHOLE,
                # never sliced: a 4+4 prefix/suffix slice of a short match
                # leaks trailing password characters (up to all of them
                # for a 2-character password) because unlike the other
                # patterns here, a slice of this match is not "less of the
                # same secret", it is the credential's own tail end.
                if [[ "${PATTERN}" == "${BASIC_AUTH_CONTENT_PATTERN}" ]]; then
                    printf '[error]   match: [REDACTED]\n' >&2
                elif [[ "${#HIT}" -le 8 ]]; then
                    printf '[error]   match: %s\n' "${HIT}" >&2
                else
                    printf '[error]   match: %s...%s\n' "${HIT:0:4}" "${HIT: -4}" >&2
                fi
            done <<< "${HITS}"
            FOUND=$(( FOUND + 1 ))
        done

        # mask every secret-shaped match (the full check-2 catalogue, not
        # only URL userinfo) before the PII sweep, which reads ADDED
        # independently of the content scan above. URL-userinfo-only masking
        # missed a blocked token sitting directly in front of "@domain.tld"
        # in plain (non-URL) content: `contact=ghp_XXXX...@example.invalid`
        # has no "://", so the old userinfo-only sed left it untouched, and
        # the PII email pattern then matched "ghp_XXXX...@example.invalid"
        # as a whole and printed the still-blocked token in full a second
        # time under an advisory heading. redacting the full catalogue first
        # also still covers the original basic-auth case
        # (`ftp://user:hunter2@host`), since BASIC_AUTH_CONTENT_PATTERN is
        # itself one of the patterns redacted here. only the matched span is
        # masked, so an ordinary personal email address is still reported as
        # designed.
        PII_SOURCE="${ADDED}"
        for PATTERN in "${SECRET_CONTENT_PATTERNS[@]}"; do
            PII_SOURCE="$(printf '%s\n' "${PII_SOURCE}" | sed -E "s|${PATTERN}|[REDACTED]|g")"
        done
        for PATTERN in "${PII_PATTERNS[@]}"; do
            HITS="$(printf '%s\n' "${PII_SOURCE}" | grep -oE -- "${PATTERN}" | sort -u || true)"
            [[ -n "${HITS}" ]] && PII_REPORT="${PII_REPORT}${HITS}"$'\n'
        done
    fi

    # filenames, independent of content. same rule as the content walk: a git
    # failure here must block, not present as "no paths in this push". same
    # --diff-merges=first-parent as the content walk, for the same reason: a
    # secret-shaped path added only while resolving a merge must still show.
    #
    # core.quotePath=false: git otherwise renders a non-ASCII path as a
    # double-quoted C-style octal escape ("\303\244-key.pem"), which puts a
    # closing quote right after the extension and defeats every `\.ext$`
    # branch of SECRET_PATH_PATTERN below.
    #
    # name-status with rename detection, not name-only: a rename or copy
    # counts under BOTH names, so `git mv id_rsa backup.txt` still lists
    # id_rsa (claude-bocuse#6 review, main line v1.10). a deletion stays
    # listed as well: the already-published check below reads it as content
    # the remote already has, which is the remediation and passes.
    if ! PATHS_STATUS="$(git -c core.quotePath=false log --name-status -M --pretty=format: \
        --diff-merges=first-parent "${LIMIT[@]}" "${ARGS[@]}" 2>/dev/null)"; then
        guard_abort "git log --name-status failed for range '${ARGS[0]}'; the filename scan did not run"
    fi
    PATHS_RAW="$(printf '%s\n' "${PATHS_STATUS}" | awk -F'\t' '
        $1 == "" { next }
        $1 ~ /^[RC]/ { print $2; print $3; next }
        { print $2 }')"
    PATHS="$(printf '%s\n' "${PATHS_RAW}" | sort -u | grep -vE '^$' || true)"
    # a rename or copy whose SOURCE is secret-shaped, "source<TAB>target". the
    # blob walk below reads the source as deleted (the remote already has it)
    # and never judges the target, whose name the pattern may not watch: the
    # key material is published under a harmless name. the source name is the
    # evidence, so these refuse whatever the target is called.
    RENAMED_SECRETS=""
    while IFS=$'\t' read -r _STATUS SRC DST; do
        [[ "${_STATUS}" =~ ^[RC] ]] || continue
        if grep -qE -- "${SECRET_PATH_PATTERN}" <<< "${SRC}"; then
            RENAMED_SECRETS="${RENAMED_SECRETS}${SRC}"$'\t'"${DST}"$'\n'
        fi
    done <<< "${PATHS_STATUS}"
    if [[ -n "${RENAMED_SECRETS}" ]]; then
        printf '[error] pre-push: secret-shaped path(s) renamed, content published under a new name:\n' >&2
        while IFS=$'\t' read -r SRC DST; do
            [[ -z "${SRC}" ]] && continue
            printf '[error]   %s renamed to %s\n' "${SRC}" "${DST}" >&2
        done <<< "${RENAMED_SECRETS}"
        FOUND=$(( FOUND + 1 ))
    fi
    if [[ -n "${PATHS}" ]]; then
        # name what the content scan did not read, so an exclusion never
        # reads as clean coverage. -x: PATHS entries are exact repo-relative
        # paths already, so this is the same match SCAN_EXCLUDE_PATHS made
        # above, from the one list rather than a second copy of it.
        SKIPPED_CONTENT="$(printf '%s\n' "${PATHS}" \
            | grep -xFf <(printf '%s\n' "${SCAN_EXCLUDE_PATHS_PLAIN}") || true)"
        if [[ -n "${SKIPPED_CONTENT}" ]]; then
            printf '[info] pre-push: catalogue source(s) in this push, content scan skipped for:\n' >&2
            printf '%s\n' "${SKIPPED_CONTENT}" | sed 's/^/[info]   /' >&2
        fi

        BAD_PATHS="$(printf '%s\n' "${PATHS}" | grep -E -- "${SECRET_PATH_PATTERN}" || true)"
        if [[ -n "${BAD_PATHS}" ]]; then
            # a path the remote already carries was published by an earlier
            # push. blocking on it again cannot un-publish it, and since the
            # name-only walk also lists paths the range DELETES, the repo
            # would stay unpushable for as long as the range exists: ~/config
            # tracks ssh/config and deleted ssh/known_hosts, which pinned
            # develop 47 commits ahead of every remote. Measured 2026-09-21.
            # What this push newly publishes is still blocked, and the content
            # scan above still reads key material in a known path.
            NEW_BAD=""
            PUBLISHED_BAD=""
            # a new ref has no remote-side sha, so its base is every branch
            # this remote already has. with push.default=current a local
            # branch whose upstream has another name pushes as a new ref, and
            # a path both remote branches carried read as newly published.
            # Measured 2026-09-23 on ~/bin awake-synology-local.
            BASES=()
            if [[ -n "${RANGE_BASE}" ]]; then
                BASES=("${RANGE_BASE}")
            else
                mapfile -t BASES < <(git for-each-ref --format='%(objectname)' \
                    "refs/remotes/${REMOTE_NAME}/" 2>/dev/null || true)
            fi
            # "already published" used to mean the TIP blob matched the
            # FIRST base (sorted by refname) that held the path: a
            # placeholder swapped for a real secret and back within the
            # same range compared equal at the tip and only warned, even
            # though the real blob sits in an intermediate commit of the
            # pushed history; and on a new ref (multiple bases) whichever
            # base for-each-ref listed first decided the outcome, not
            # which base actually carried the pushed blob.
            #
            # collect every base's blob for the path first, across ALL
            # bases, not the first match. then walk every commit in the
            # range that touches the path (same LIMIT/ARGS as the
            # content scan above, so a capped range stays capped
            # consistently) and resolve each commit's blob; a commit
            # that deletes the path is skipped, since deleting publishes
            # no content. block if any range blob is missing from the
            # base set: that blob was published somewhere in this push's
            # history even if a later commit in the same range reverted
            # it. warn only when every range blob is already in the base
            # set, or the path is touched only by deletions in this
            # range.
            while IFS= read -r BAD_PATH; do
                [[ -z "${BAD_PATH}" ]] && continue
                BASE_BLOBS=()
                for BASE in "${BASES[@]}"; do
                    if BLOB="$(git rev-parse -q --verify "${BASE}:${BAD_PATH}" 2>/dev/null)"; then
                        BASE_BLOBS+=("${BLOB}")
                    fi
                done
                if ! RANGE_SHAS="$(git log --format=%H --diff-merges=first-parent \
                    "${LIMIT[@]}" "${ARGS[@]}" -- "${BAD_PATH}" 2>/dev/null)"; then
                    guard_abort "git log failed resolving range history of '${BAD_PATH}'; the already-published check did not run"
                fi
                RANGE_BLOBS=()
                while IFS= read -r RANGE_SHA; do
                    [[ -z "${RANGE_SHA}" ]] && continue
                    if BLOB="$(git rev-parse -q --verify "${RANGE_SHA}:${BAD_PATH}" 2>/dev/null)"; then
                        RANGE_BLOBS+=("${BLOB}")
                    fi
                done <<< "${RANGE_SHAS}"
                ALL_KNOWN=1
                for RANGE_BLOB in "${RANGE_BLOBS[@]}"; do
                    KNOWN=0
                    for BASE_BLOB in "${BASE_BLOBS[@]}"; do
                        if [[ "${RANGE_BLOB}" == "${BASE_BLOB}" ]]; then
                            KNOWN=1
                            break
                        fi
                    done
                    if (( ! KNOWN )); then
                        ALL_KNOWN=0
                        break
                    fi
                done
                if [[ "${#RANGE_BLOBS[@]}" -eq 0 ]] || (( ALL_KNOWN )); then
                    PUBLISHED_BAD="${PUBLISHED_BAD}${BAD_PATH}"$'\n'
                else
                    NEW_BAD="${NEW_BAD}${BAD_PATH}"$'\n'
                fi
            done <<< "${BAD_PATHS}"

            if [[ -n "${PUBLISHED_BAD}" ]]; then
                printf '[warn] pre-push: secret-shaped path(s) the remote already has:\n' >&2
                printf '%s' "${PUBLISHED_BAD}" | sed 's/^/[warn]   /' >&2
            fi
            if [[ -n "${NEW_BAD}" ]]; then
                printf '[error] pre-push: secret-shaped path(s) newly published:\n' >&2
                printf '%s' "${NEW_BAD}" | sed 's/^/[error]   /' >&2
                FOUND=$(( FOUND + 1 ))
            fi
        fi
    fi
done

if [[ -n "${SKIPPED_NOTE}" ]]; then
    printf '[warn] pre-push: scan capped at %d commits per ref (%s)\n' "${MAX_COMMITS}" "${SKIPPED_NOTE}" >&2
fi

if [[ -n "${PII_REPORT}" ]]; then
    PII_UNIQUE="$(printf '%s' "${PII_REPORT}" | grep -vE '^$' | sort -u || true)"
    if [[ -n "${PII_UNIQUE}" ]]; then
        printf '[warn] pre-push: personal identifier(s) in this push (advisory, not blocking):\n' >&2
        printf '%s\n' "${PII_UNIQUE}" | head -20 | sed 's/^/[warn]   /' >&2
        printf '[warn] confirm the target remote is private before publishing these.\n' >&2
    fi
fi

if (( FOUND > 0 )); then
    printf '[error] pre-push blocked: %d finding(s).\n' "${FOUND}" >&2
    printf '[info]  rotate any real credential at its issuer FIRST; a push that\n' >&2
    printf '[info]  already happened cannot be recalled, and history rewriting\n' >&2
    printf '[info]  does not un-leak it.\n' >&2
    printf '[info]  for fixtures, replace the value with an obvious placeholder.\n' >&2
    exit 1
fi

printf '[pass] pre-push: no secret-shaped content or path detected\n' >&2

# chain to git-lfs pre-push if the repo uses LFS. preserves the LFS-installed
# pre-push behaviour (the hook git-lfs writes when `git lfs install` runs)
# while keeping the security check ahead of it. the buffered ref updates are
# replayed on its stdin, since this hook already consumed them. if either
# side is missing, this block is a no-op (security check is sufficient).
if command -v git-lfs >/dev/null 2>&1; then
    if git config --get-regexp '^lfs\.' >/dev/null 2>&1 \
       || (git rev-parse --show-toplevel >/dev/null 2>&1 \
           && [[ -f "$(git rev-parse --show-toplevel)/.gitattributes" ]] \
           && grep -q "filter=lfs" "$(git rev-parse --show-toplevel)/.gitattributes"); then
        printf '%s\n' "${REF_UPDATES}" | git lfs pre-push "$@"
        exit $?
    fi
fi

exit 0
