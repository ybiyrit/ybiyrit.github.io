#!/usr/bin/env bash
# commit-msg hook: refuse a subject that records nothing, and refuse an
# agent provenance trailer
#
# 83997e3 landed on 2026-09-07 with the subject "Update". It carried 310
# lines across two files and is pushed, so under the fix-forward rule it
# cannot be corrected by a rewrite: the reason had to go into CHANGELOG.md
# afterwards instead. A commit message is the one place a change explains
# itself to the next reader, and the cost of getting it wrong is permanent.
#
# What is rejected is deliberately narrow, because a hook that argues about
# wording trains people to pass --no-verify:
#   - fewer than three words, or shorter than 15 characters
#   - a subject that is only a filler verb ("update", "fix", "wip", ...)
# Everything else passes. Merge, revert, fixup and squash subjects are
# generated by git itself and are exempt.
#
# There is deliberately no upper length bound. The usual 50 or 72 character
# advice does not describe this repo: measured over the last 200 commits in
# ~/bin the median subject is 67 characters, the 90th percentile 78 and the
# longest 93, with 30 percent past 72. A first draft of this hook capped at
# 72 and rejected 13 of 39 real subjects, every one of them well written.
# The failure this guards is too little information, not too much.
#
# Bypass for a genuine exception: git commit --no-verify
set -o errexit -o nounset -o pipefail -o errtrace

MSG_FILE="$1"

# first non-blank, non-comment line, read without a pipeline. `grep | head -1`
# looks equivalent and is not: under pipefail a message that is entirely
# comments makes grep exit 1, and a message long enough for head to close the
# pipe early kills grep with SIGPIPE (141). errexit then aborts the hook at
# this assignment, so the commit is refused with no diagnostic at all and a
# perfectly good long message is rejected. The loop has no such failure mode.
# (fix from ybiyrit/talks e364b2f, 2026-09-22)
SUBJECT=""
LINE=""
while IFS= read -r LINE || [[ -n "${LINE}" ]]; do
  [[ "${LINE}" =~ ^[[:space:]]*(#|$) ]] && continue
  SUBJECT="${LINE}"
  break
done < "${MSG_FILE}"

# git generates these subjects; they are not authored prose, so the subject
# checks skip them. the provenance scan below still runs: an early exit here
# let "Merge ..." carry an agent trailer straight in. (copilot review,
# claude-bocuse#5, flux-compensator#1, polder#1)
GIT_SUBJECT=0
case "${SUBJECT}" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) GIT_SUBJECT=1 ;;
esac

fail() {
  printf '[fail] commit-msg: %s\n' "$1" >&2
  printf '        subject: %s\n' "${SUBJECT:-<empty>}" >&2
  printf '[info]  say what changed and why. bypass once: git commit --no-verify\n' >&2
  exit 1
}

if (( GIT_SUBJECT == 0 )); then
[[ -z "${SUBJECT}" ]] && fail "empty subject"

# a filler verb alone records nothing. matched on the whole subject, so
# "update the drift check to reach zero" is fine and "Update" is not.
shopt -s nocasematch
if [[ "${SUBJECT}" =~ ^(update|updates|fix|fixes|fixed|wip|tmp|temp|test|misc|stuff|changes?|edit|edits|tweak|tweaks|cleanup|refactor|minor|various|asdf|foo)[[:punct:]]*$ ]]; then
  shopt -u nocasematch
  fail "subject is a filler verb and records nothing"
fi
shopt -u nocasematch

WORDS="$(wc -w <<<"${SUBJECT}")"
(( WORDS < 3 )) && fail "subject has ${WORDS} word(s); at least 3 needed"
(( ${#SUBJECT} < 15 )) && fail "subject is ${#SUBJECT} characters; at least 15 needed"
fi

# agent provenance does not enter the history: the work is attributed to the
# human. 9c285d8 landed on 2026-09-08 carrying "Generated by Mistral Vibe"
# and "Co-Authored-By: Mistral Vibe <vibe@mistral.ai>". It is pushed, so
# under the fix-forward rule it cannot be corrected by a rewrite; only the
# next commit can be stopped, which is what this does. Several CLIs append
# such a trailer by default, so the leak recurs until it is guarded.
#
# Narrow on purpose, so it never argues with prose: only an attribution LINE
# is examined, never a mention. "claude: re-apply the policy settings" is a
# scope prefix and passes. A human co-author passes; only a vendor name in a
# Co-Authored-By line fails. Verified by .githooks/test-commit-msg.sh, which
# asserts one rejected sample per token and the passing controls.
AGENT_TOKENS='claude|anthropic|copilot|gemini|antigravity|mistral|vibe|openai|chatgpt|codex|cursor|devin|aider|windsurf'

fail_provenance() {
  printf '[fail] commit-msg: agent provenance trailer\n' >&2
  printf '        line: %s\n' "$1" >&2
  printf '[info]  the work is attributed to the human; drop the line.\n' >&2
  printf '[info]  bypass once: git commit --no-verify\n' >&2
  exit 1
}

# the `|| [[ -n "${LINE}" ]]` tail reads a final line that carries no newline.
# git's own editor always terminates the last line, but `git commit -F -` and
# `git commit -F <file>` do not have to, and a trailer is by definition the
# last line: without this the guard silently skipped exactly the line it
# exists to catch.
LINE=""
while IFS= read -r LINE || [[ -n "${LINE}" ]]; do
  # git strips these before writing the object, so they are not part of the message
  [[ "${LINE}" =~ ^[[:space:]]*# ]] && continue
  shopt -s nocasematch
  # leading non-alphanumerics absorb a robot emoji or a bullet. the line must
  # name an agent: "Generated by the migration script" is prose, and the
  # unconditional form rejected it. (copilot review, claude#3)
  if [[ "${LINE}" =~ ^[[:space:]]*[^[:alnum:][:space:]]*[[:space:]]*generated[[:space:]]+(with|by)[[:space:]].*(${AGENT_TOKENS}) ]]; then
    shopt -u nocasematch
    fail_provenance "${LINE}"
  fi
  if [[ "${LINE}" =~ ^[[:space:]]*co-authored-by:.*(${AGENT_TOKENS}) ]]; then
    shopt -u nocasematch
    fail_provenance "${LINE}"
  fi
  shopt -u nocasematch
done < "${MSG_FILE}"

# staged content that Synology Drive wrote rather than someone editing here.
# Drive leaves whole-second mtimes (observed on fry1, not documented by
# Synology). On 2026-09-23 a commit on fry1 carried a copy Drive had rolled
# back two minutes earlier, under a message describing the opposite content.
# Warn only, because committing another host's work is sometimes the point.
# A file whose staged blob differs from the working file is not flagged: it
# was edited after Drive wrote it.
DRIVE_STAGED=""
while IFS= read -r -d '' P; do
  [[ -f "${P}" ]] || continue
  [[ "$(stat -c %y "./${P}" 2>/dev/null)" == *".000000000 "* ]] || continue
  WORK_BLOB="$(git hash-object "./${P}" 2>/dev/null)" || continue
  [[ "${WORK_BLOB}" == "$(git rev-parse ":${P}" 2>/dev/null)" ]] || continue
  DRIVE_STAGED+="        ${P}"$'\n'
done < <(git diff --cached --name-only -z --diff-filter=AM 2>/dev/null)
if [[ -n "${DRIVE_STAGED}" ]]; then
  printf '[warn] commit-msg: staged content was written by Synology Drive, not edited here:\n%s' "${DRIVE_STAGED}" >&2
  printf '[info]  another host may have rolled it back. check before pushing: git show --stat HEAD\n' >&2
fi

exit 0
